generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Konfigurasi dataset — menyimpan info header & koordinat
model Dataset {
  id        String   @id @default(cuid())
  name      String   @default("Unnamed Dataset")
  headers   String[] /// Semua kolom dari Excel
  latCol    String?  /// Nama kolom latitude (terpisah)
  lngCol    String?  /// Nama kolom longitude (terpisah)
  coordCol  String?  /// Nama kolom koordinat gabungan (format: lat, lng)
  rowCount  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  points    DataPoint[]

  @@index([isActive])
}

/// Titik data — format-agnostic, semua kolom Excel disimpan di metadata (JSONB)
model DataPoint {
  id        String   @id @default(cuid())
  datasetId String
  latitude  Float
  longitude Float
  metadata  Json     /// Semua kolom Excel (kecuali koordinat)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dataset   Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
  @@index([latitude, longitude])
}
